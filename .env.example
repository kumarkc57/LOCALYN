# LOCALYN CIE-1 Environment Variables
# Copy this file to .env and configure your API keys

# NewsData.io API Key for Bengaluru local news
NEWSDATA_API_KEY=your_newsdata_api_key_here

# OpenWeatherMap API Key for Bengaluru weather observations
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SQLite Database path (relative to backend or absolute)
DB_PATH=backend/localyn.db

# Server configuration
HOST=0.0.0.0
PORT=8000

# Automated Background Ingestion (Periodically fetches live news & weather)
AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_MINUTES=15
